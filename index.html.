
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#171513">
<title>Beyond the Fool</title>
<style>
*{box-sizing:border-box}
body{
  margin:0;background:#171513;color:#e7dcc5;
  font-family:Georgia,serif;padding:16px;
}
main{max-width:600px;margin:auto}
h1{color:#c5a36b;text-align:center}
.card{
  background:#25211d;border:1px solid #554631;
  padding:15px;border-radius:12px;margin:12px 0;
}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:10px}
button{
  width:100%;padding:13px;margin:5px 0;
  border:1px solid #92754b;border-radius:8px;
  background:#393027;color:#f2e4c9;
  font-size:16px;
}
button:active{background:#655035}
small{color:#b9a88c}
#log p{border-bottom:1px solid #514334;padding-bottom:8px}
</style>
</head>
<body>
<main>
<h1>BEYOND THE FOOL</h1>
<p style="text-align:center">Tingen · Kỷ Nguyên thứ Năm</p>

<section class="card">
  <h3 id="date">Ngày 1 · 06:00</h3>
  <div class="stats">
    <div>£ Tiền: <b id="money">20</b></div>
    <div>❤ Sức khỏe: <b id="hp">100</b></div>
    <div>⚡ Thể lực: <b id="energy">100</b></div>
    <div>◈ Tinh thần: <b id="sanity">100</b></div>
  </div>
</section>

<section class="card">
  <h3>Hiện tại</h3>
  <p id="story">Bạn vừa thức dậy trong căn phòng thuê
  nhỏ tại Tingen. Một ngày mới bắt đầu.</p>
</section>

<section class="card">
  <h3>Hành động</h3>
  <button onclick="act('work')">Đi làm (8 giờ)</button>
  <button onclick="act('study')">Đọc sách (2 giờ)</button>
  <button onclick="act('explore')">Khám phá thành phố (2 giờ)</button>
  <button onclick="act('eat')">Ăn uống (30 phút)</button>
  <button onclick="act('sleep')">Ngủ (8 giờ)</button>
</section>

<section class="card">
  <h3>Nhật ký</h3>
  <div id="log"></div>
</section>
</main>

<script>
const initial = {
 day:1, hour:6, minute:0,
 money:20, hp:100, energy:100, sanity:100
};

let game = {...initial};
let logs = [];

function save(){
 localStorage.setItem('beyond-save',JSON.stringify({
  game,logs
 }));
}

function load(){
 try{
  const data=JSON.parse(
   localStorage.getItem('beyond-save')
  );
  if(data?.game){
   game={...initial,...data.game};
   logs=Array.isArray(data.logs)?data.logs:[];
  }
 }catch(e){}
}

function log(text){
 logs.unshift(text);
 logs=logs.slice(0,12);
 document.getElementById('log').innerHTML=
 logs.map(x=>`<p>${x}</p>`).join('');
}

function advance(minutes){
 let total=game.hour*60+game.minute+minutes;
 game.day+=Math.floor(total/1440);
 total%=1440;
 game.hour=Math.floor(total/60);
 game.minute=total%60;

 if(minutes>0){
  game.energy=Math.max(0,game.energy-minutes/20);
 }
}

function act(type){
 let cost=0;
 let message='';

 if(type==='work'){
  cost=480;
  game.money+=8;
  message='Bạn hoàn thành một ngày làm việc. +£8';
 }
 if(type==='study'){
  cost=120;
  game.sanity-=2;
  message='Bạn dành thời gian nghiên cứu tài liệu.';
 }
 if(type==='explore'){
  cost=120;
  game.energy-=5;
  message='Bạn khám phá những con phố của Tingen.';
 }
 if(type==='eat'){
  cost=30;
  game.money-=1;
  game.energy=Math.min(100,game.energy+15);
  message='Bạn dùng một bữa ăn. -£1';
 }
 if(type==='sleep'){
  cost=480;
  game.energy=100;
  game.hp=Math.min(100,game.hp+10);
  game.sanity=Math.min(100,game.sanity+5);
  message='Bạn ngủ một giấc dài.';
 }

 if(game.energy<=0 && type!=='sleep'){
  log('Bạn đã kiệt sức. Hãy nghỉ ngơi!');
  return;
 }

 if(type==='work' && game.energy<20){
  log('Bạn không đủ thể lực để đi làm.');
  return;
 }

 advance(cost);
 game.energy=Math.max(0,game.energy);
 game.sanity=Math.max(0,Math.min(100,game.sanity));

 log(message);
 render();
 save();
}

function render(){
 document.getElementById('date').textContent=
 `Ngày ${game.day} · ${
 String(game.hour).padStart(2,'0')
 }:${
 String(game.minute).padStart(2,'0')
 }`;

 ['money','hp','energy','sanity'].forEach(key=>{
  document.getElementById(key).textContent=
  Math.floor(game[key]);
 });
}

load();
render();
log('Bạn bắt đầu cuộc sống mới tại Tingen.');
</script>
</body>
</html>
